  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 505309552}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2066c855a0bf04b429d48336158102de, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  district: {fileID: 2066793201}
  brush: {fileID: 993818187}
  figures:
  - view: 0
    image: {fileID: 2800000, guid: c2dcd199a5957ee468873f3adec4988f, type: 3}
    title: 'Nasr City: photo, materials, heat and risk'
    caption: "Nasr City from the analysis: (a) Sentinel-2 summer photo, (b) surface
      materials at 10 m, (c) summer surface temperature per 90 m block, (d) heat
      risk: residents \xD7 \xB0C above the typical block. White blocks in (d) are
      cooler than typical."
  - view: 1
    image: {fileID: 2800000, guid: 7b5e1e0da99d9284790991d7b9c1d460, type: 3}
    title: 'East Cairo: summer surface temperature'
    caption: The model area. (a) Sentinel-2 summer photo; (b) Landsat summer surface
      temperature per 90 m block, centred on the typical urban block. Bare desert
      (orange) is hotter than the built, irrigated city (blue). The box is the Nasr
      City district shown in this app.
  - view: 1
    image: {fileID: 2800000, guid: ce485a5ad6642fe47811c2115f6bba36, type: 3}
    title: 'Heat model: tested on areas it never saw'
    caption: Measured vs predicted block temperature, with whole 1 km areas hidden
      while the model learned (spatial cross-validation). Good enough to compare
      cooling measures, not to predict one block exactly.
  - view: 1
    image: {fileID: 2800000, guid: 440e46a65aec23d4684590a172f4c159, type: 3}
    title: Does hyperspectral data help?
    caption: "How well each set of satellite bands explains block surface temperature,
      tested on hidden 1, 2 and 3 km areas. EnMAP's full spectrum clearly beats Sentinel-2.
      Contains modified EnMAP data \xA9 DLR [2025]."
  - view: 2
    image: {fileID: 2800000, guid: c2dcd199a5957ee468873f3adec4988f, type: 3}
    title: 'Nasr City: photo, materials, heat and risk'
    caption: "Nasr City from the analysis: (a) Sentinel-2 summer photo, (b) surface
      materials at 10 m, (c) summer surface temperature per 90 m block, (d) heat
      risk: residents \xD7 \xB0C above the typical block. White blocks in (d) are
      cooler than typical."
  - view: 2
    image: {fileID: 2800000, guid: 86633b688c08f404daf600ce877531ef, type: 3}
    title: What each cooling measure would do
    caption: 'Change in Nasr City''s heat exposure. Blue: each measure at full adoption
      in every block. Orange: cool roofs and pocket parks on only the riskiest third
      of blocks.'
  - view: 3
    image: {fileID: 2800000, guid: d82b217efe20fa44aa62d514aabfc11d, type: 3}
    title: "Urban growth 2016\u20132023"
    caption: "From Google Open Buildings Temporal: (a) block classes, same colours
      as this view; (b) building footprint area per year; (c) mean summer surface
      temperature of blocks built before 2016, built 2016\u20132023 and still open."
